        "ship",
        "sheep"
      ],
      [
        "sit",
        "seat"
      ],
      [
        "live",
        "leave"
      ]
    ]
  },
  {
    "id": "b-p",
    "title": "B vs P",
    "sounds": [
      "/b/",
      "/p/"
    ],
    "tip": "/b/ is voiced. /p/ is voiceless and often has a puff of air at the start of a stressed syllable.",
    "pairs": [
      [
        "bat",
        "pat"
      ],
      [
        "bin",
        "pin"
      ],
      [
        "beach",
        "peach"
      ]
    ]
  },
  {
    "id": "f-v",
    "title": "F vs V",
    "sounds": [
      "/f/",
      "/v/"
    ],
    "tip": "Both use upper teeth against the lower lip. /f/ is voiceless; /v/ uses vocal-fold vibration.",
    "pairs": [
      [
        "fan",
        "van"
      ],
      [
        "fine",
        "vine"
      ],
      [
        "safe",
        "save"
      ],
      [
        "leaf",
        "leave"
      ]
    ]
  },
  {
    "id": "n-l",
    "title": "N vs L",
    "sounds": [
      "/n/",
      "/l/"
    ],
    "tip": "Both touch the ridge behind the upper teeth. For /n/, air flows through the nose; for /l/, air flows around the sides of the tongue.",
    "pairs": [
      [
        "night",
        "light"
      ],
      [
        "no",
        "low"
      ],
      [
        "nine",
        "line"
      ]
    ]
  },
  {
    "id": "s-sh",
    "title": "S vs SH",
    "sounds": [
      "/s/",
      "/ʃ/"
    ],
    "tip": "For /s/, keep the tongue closer to the front teeth. For /ʃ/, draw it slightly back and round the lips a little.",
    "pairs": [

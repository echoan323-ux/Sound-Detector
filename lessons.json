        "shoe"
      ]
    ]
  },
  {
    "id": "ch-sh",
    "title": "CH vs SH",
    "sounds": [
      "/tʃ/",
      "/ʃ/"
    ],
    "tip": "/tʃ/ begins with a brief stop before releasing air; /ʃ/ is continuous friction.",
